/*b) depois que esta parte inicial funcionar e você tiver terminado a lista
inteira, altere o programa de forma a considerar também os minutos.*/

#include <stdio.h>

int main()
{
    int hora_inicio, min_inicio, hora_fim, min_fim;
    scanf("%d %d %d %d", &hora_inicio, &min_inicio, &hora_fim, &min_fim);

    min_inicio = min_inicio + hora_inicio*60;
    min_fim = min_fim + hora_fim*60;

    if (min_inicio>=min_fim)
    {   min_fim = min_fim+1440;
    }

    int duracao = min_fim - min_inicio;

    printf("O jogo durou %d hora(s) e %d minuto(s). \n", duracao/60, duracao%60);

    return 0;
}
