/*Escreva um programa que recebe 3 números distintos e os mostra em ordem crescente. O
programa deve usar apenas 3 variáveis, e os seus conteúdos não devem ser modificados após a
leitura dos valores.*/

#include <stdio.h>

int main()
{
    int num1, num2, num3;
    printf("Insira 3 numeros: \n");
    scanf("%d %d %d", &num1, &num2, &num3);

    if (num1<num2 && num1<num3)
    {   printf("%d ", num1);
        if (num2<num3)
            printf("%d %d", num2, num3);
        else
            printf("%d %d", num3, num2);
    }
    else if (num2<num1 && num2<num3)
    {   printf("%d ", num2);
        if (num1<num3)
            printf("%d %d", num1, num3);
        else
            printf("%d %d", num3, num1);
    }
    else
    {   printf("%d ", num3);
        if (num2<num1)
            printf("%d %d", num2, num1);
        else
            printf("%d %d", num1, num2);
    }
    return 0;
}
