/*Escreva um programa que recebe um número inteiro e imprime "SIM" se o número for par e maior
do que 10, ou for ímpar e menor do que 50. Caso contrário, o programa deve imprimir "NAO". Use
operadores lógicos para testar as condições. O programa deve ter uma única estrutura if... else.*/

#include<stdio.h>

int main()
{
    int num;
    scanf("%d", &num);

    if ((num%2==0 && num>10) || (num%2!=0 && num<50))
    {
        printf("SIM\n");
    }
    else
    {
        printf("NAO\n");
    }

    return 0;
}
